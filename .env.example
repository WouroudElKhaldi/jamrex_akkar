# ---------- Production only (docker-compose) ----------
DB_PASSWORD="change-me-strong-db-password"

# ---------- Core ----------
DATABASE_URL="postgresql://jamrex:jamrex@localhost:5432/jamrex_miniyeh?schema=public"
SITE_URL="http://localhost:3000"
# 48+ random chars. Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# ---------- Secret admin URL ----------
# The dashboard lives at  SITE_URL/<ADMIN_PATH>  (and /adm is a hard 404).
# Use a long random string, only letters/numbers/dashes. Change it any time.
ADMIN_PATH="staff-9f3k2x7q1m"

# ---------- Owner account (created by `npm run db:seed`) ----------
OWNER_NAME="Owner"
OWNER_EMAIL="owner@jamrexminiyeh.com"
OWNER_PASSWORD="change-me-to-a-strong-password-12+"

# ---------- Files ----------
# Uploaded product photos live here. In production mount a persistent volume.
UPLOAD_DIR="./uploads"

# ---------- Notifications ----------
# Telegram: create a bot with @BotFather, add it to the staff group, get the chat id.
TELEGRAM_BOT_TOKEN=""
# One id or several separated by commas, e.g. "-1001234567890,123456789" (group and/or employees' personal ids)
TELEGRAM_CHAT_ID=""
# Email (optional backup)
# Customer e-mails (confirm your e-mail, set password). Easiest free option: Resend (100 e-mails/day, 3,000/month).
#  1) sign up at resend.com  2) add & verify your domain jamrexminiyeh.com (DNS records)  3) create an API key
RESEND_API_KEY=""
EMAIL_FROM="Jamrex Miniyeh <no-reply@jamrexminiyeh.com>"

# Optional: plain SMTP instead (also used for the "new order" e-mail to the shop)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Jamrex Miniyeh <info@jamrexminiyeh.com>"
ORDER_EMAIL_TO=""
# Web Push for the staff app. Generate with: npm run vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@jamrexminiyeh.com"

# ---------- Whish Pay ----------
# sandbox: https://partner.api.sbx.whish.money/itel-service/api
# production: https://api.whish.money/itel-service/api
WHISH_BASE_URL="https://partner.api.sbx.whish.money/itel-service/api"
WHISH_CHANNEL=""
WHISH_SECRET=""
WHISH_WEBSITE_URL=""

# ---------- Cron ----------
# Called every 5 minutes by the server cron: curl -H "x-cron-secret: $CRON_SECRET" $SITE_URL/api/cron/reconcile
CRON_SECRET="change-me"
