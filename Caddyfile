# Automatic HTTPS (Let's Encrypt). Point the domain's A record to the droplet IP first.
jamrexminiyeh.com, www.jamrexminiyeh.com {
	encode zstd gzip

	@www host www.jamrexminiyeh.com
	redir @www https://jamrexminiyeh.com{uri} permanent

	# uploaded photos that already exist on disk are served by Caddy itself (fast, zero Node CPU);
	# anything else (including the first request for a small thumbnail) goes to the app
	@upfile {
		path /uploads/*
		file {
			root /srv
		}
	}
	handle @upfile {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
		header X-Content-Type-Options nosniff
		file_server
	}

	# never trust X-Forwarded-* sent by visitors: Caddy sets them itself (the app's rate limiter relies on this)
	handle {
		reverse_proxy app:3000 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Real-IP
		}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}
	request_body {
		max_size 40MB
	}
}
